# AWS Amplify Configuration
# These values are auto-generated by `amplify push` into src/aws-exports.js
# This file documents the environment variables available for customization.

# Optional: Override API endpoint for local development
# REACT_APP_API_ENDPOINT=http://localhost:20002

# Optional: Enable mock data for development without AWS backend
# REACT_APP_USE_MOCK_DATA=true

# Optional: Google Maps API key for map integration
# REACT_APP_GOOGLE_MAPS_API_KEY=your_key_here

# Optional: Analytics tracking
# REACT_APP_ANALYTICS_ID=your_analytics_id
